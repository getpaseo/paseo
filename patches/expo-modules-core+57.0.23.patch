+package expo.modules.kotlin.activityresult
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import androidx.appcompat.app.AppCompatActivity
+import expo.modules.kotlin.providers.CurrentActivityProvider
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], manifest = Config.NONE)
+class AppContextActivityResultRegistryRecreationTest {
+  private class ActivityProvider(override var currentActivity: Activity?) : CurrentActivityProvider
+
+  private val contract = object : AppContextActivityResultContract<String, String> {
+    override fun createIntent(context: Context, input: String) = Intent("test.PICK_IMAGE")
+    override fun parseResult(input: String, resultCode: Int, intent: Intent?) = "$input:$resultCode"
+  }
+
+  private fun createActivity() = Robolectric.buildActivity(AppCompatActivity::class.java).apply {
+    get().setTheme(androidx.appcompat.R.style.Theme_AppCompat)
+  }.setup()
+
+  @Test
+  fun inFlightResultReachesOriginalCallerAfterRepeatedActivityRecreation() {
+    var controller = createActivity()
+    val provider = ActivityProvider(controller.get())
+    val registry = AppContextActivityResultRegistry(provider)
+    val results = mutableListOf<String>()
+    val fallbackResults = mutableListOf<String>()
+    val launcher = registry.register("image", controller.get(), contract) { _, result ->
+      fallbackResults.add(result)
+    }
+
+    // Both selection and cancellation must settle the awaiting picker call.
+    listOf(Activity.RESULT_OK, Activity.RESULT_CANCELED, Activity.RESULT_OK).forEachIndexed { index, code ->
+      launcher.launch("image-$index") { results.add(it) }
+      val started = shadowOf(controller.get()).nextStartedActivityForResult
+      controller.pause().stop().destroy()
+      controller = createActivity()
+      provider.currentActivity = controller.get()
+
+      assertTrue(registry.dispatchResult(started.requestCode, code, null))
+      assertEquals(index + 1, results.size)
+      assertEquals("image-$index:$code", results.last())
+      // A completed request from the destroyed Activity is no longer registered.
+      assertFalse(registry.dispatchResult(started.requestCode, code, null))
+    }
+
+    launcher.launch("next-pick") { results.add(it) }
+    val next = shadowOf(controller.get()).nextStartedActivityForResult
+    assertTrue(registry.dispatchResult(next.requestCode, Activity.RESULT_OK, null))
+    assertEquals(listOf("image-0:-1", "image-1:0", "image-2:-1", "next-pick:-1"), results)
+    assertEquals(emptyList<String>(), fallbackResults)
+    controller.pause().stop().destroy()
+  }
+
+  @Test
+  fun restoredRegistryStillUsesFallbackWithoutTheOriginalAppContext() {
+    val previous = createActivity()
+    val provider = ActivityProvider(previous.get())
+    val original = AppContextActivityResultRegistry(provider)
+    val results = mutableListOf<String>()
+    val launcher = original.register("image", previous.get(), contract) { _, result ->
+      results.add("old-fallback:$result")
+    }
+    launcher.launch("restored-image") { results.add("old-caller:$it") }
+    val started = shadowOf(previous.get()).nextStartedActivityForResult
+    original.persistInstanceState(previous.get())
+    previous.pause().stop().destroy()
+
+    val replacement = createActivity()
+    provider.currentActivity = replacement.get()
+    val restored = AppContextActivityResultRegistry(provider)
+    restored.restoreInstanceState(replacement.get())
+    restored.register("image", replacement.get(), contract) { _, result ->
+      results.add("fallback:$result")
+    }
+
+    assertTrue(restored.dispatchResult(started.requestCode, Activity.RESULT_OK, null))
+    assertEquals(listOf("fallback:restored-image:-1"), results)
+    replacement.pause().stop().destroy()
+  }
+
+  @Test
+  fun retainedLauncherDeliversResultsAfterRepeatedActivityRecreation() {
+    var controller = createActivity()
+    val provider = ActivityProvider(controller.get())
+    val registry = AppContextActivityResultRegistry(provider)
+    val fallbackResults = mutableListOf<String>()
+    val launcher = registry.register("image", controller.get(), contract) { _, result ->
+      fallbackResults.add(result)
+    }
+    val results = mutableListOf<String>()
+
+    repeat(3) { iteration ->
+      controller.pause().stop().destroy()
+      controller = createActivity()
+      provider.currentActivity = controller.get()
+
+      launcher.launch("image-$iteration") { results.add(it) }
+      val started = shadowOf(controller.get()).nextStartedActivityForResult
+      assertEquals("test.PICK_IMAGE", started.intent.action)
+      assertTrue(registry.dispatchResult(started.requestCode, Activity.RESULT_OK, null))
+    }
+
+    assertEquals(listOf("image-0:-1", "image-1:-1", "image-2:-1"), results)
+    assertEquals(emptyList<String>(), fallbackResults)
+    controller.pause().stop().destroy()
+  }
+
+  @Test
+  fun retainedLauncherUsesReplacementThatResumesBeforePreviousActivityIsDestroyed() {
+    val previous = createActivity()
+    val provider = ActivityProvider(previous.get())
+    val registry = AppContextActivityResultRegistry(provider)
+    val results = mutableListOf<String>()
+    val launcher = registry.register("image", previous.get(), contract) { _, result ->
+      results.add("fallback:$result")
+    }
+    previous.pause()
+    val replacement = createActivity()
+    provider.currentActivity = replacement.get()
+    previous.stop().destroy()
+
+    launcher.launch("replacement") { results.add(it) }
+    val started = shadowOf(replacement.get()).nextStartedActivityForResult
+    assertTrue(registry.dispatchResult(started.requestCode, Activity.RESULT_OK, null))
+    assertEquals(listOf("replacement:-1"), results)
+    replacement.pause().stop().destroy()
+  }
+}
