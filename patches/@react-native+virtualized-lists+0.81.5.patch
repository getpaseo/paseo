--- /dev/null
+++ b/node_modules/@react-native/virtualized-lists/Lists/boundRetainedRangeOnDataGrowth.js
@@ -0,0 +1,28 @@
+/**
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ *
+ * @format
+ */
+
+'use strict';
+
+export function boundRetainedRangeOnDataGrowth(
+  cellsAroundViewport,
+  previousItemCount,
+  itemCount,
+  retainedCellLimit,
+) {
+  if (itemCount <= previousItemCount) {
+    return cellsAroundViewport;
+  }
+  return {
+    first: cellsAroundViewport.first,
+    last: Math.min(
+      cellsAroundViewport.last,
+      cellsAroundViewport.first + retainedCellLimit - 1,
+    ),
+  };
+}
