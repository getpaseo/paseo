+  // Prefix every copy with a UUID so two shared files with the same name don't overwrite each other.
+  // The original name travels in the payload metadata.
+  nonisolated private static func uniqueDestination(in containerURL: URL, fileName: String) -> URL {
+    return containerURL.appendingPathComponent("\(UUID().uuidString)-\(fileName)")
+  }
+
+  // Keep the sender's file name for data-backed items instead of a random one.
+  nonisolated private static func dataFileName(suggestedName: String?, identifier: String) -> String {
+    let suggestedName = (suggestedName ?? "").replacingOccurrences(of: "/", with: "_")
+    if suggestedName.isEmpty {
+      return UUID().randomFilename(forTypeIdentifier: identifier)
+    }
+    guard (suggestedName as NSString).pathExtension.isEmpty,
+      let preferredExtension = UTType(identifier)?.preferredFilenameExtension
+    else {
+      return suggestedName
+    }
+    return "\(suggestedName).\(preferredExtension)"
+  }
