+import { INITIAL_STATE } from './constants';
+import { reducer } from './reducer';
+import type { PortalType } from '../types';
+import type { ActionTypes } from './types';
+
+const NO_PORTALS: Array<PortalType> = [];
+
+// Paseo patch: portal state lives in a store, outside React state. Held in the provider's context
+// value it changed on every portal add, update and remove, and React then walked every fiber under
+// the provider (the whole app) to find the hosts consuming it. Hosts subscribe here instead.
+export const createPortalStore = () => {
+  let state: Record<string, Array<PortalType>> = INITIAL_STATE;
+  const listeners = new Set<() => void>();
+
+  return {
+    getPortals: (hostName: string) => state[hostName] || NO_PORTALS,
+    dispatch: (action: ActionTypes) => {
+      state = reducer(state, action);
+      listeners.forEach(listener => listener());
+    },
+    subscribe: (listener: () => void) => {
+      listeners.add(listener);
+      return () => {
+        listeners.delete(listener);
+      };
+    },
+  };
+};
+
+export type PortalStore = ReturnType<typeof createPortalStore>;
