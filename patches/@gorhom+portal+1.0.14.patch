   //#endregion
 
   //#region render
-  return <>{state.map(item => item.node)}</>;
+  // Backport of https://github.com/gorhom/react-native-portal/pull/62: without a key, removing a
+  // portal shifts the ones after it and React remounts them.
+  return (
+    <>
+      {state.map(item => (
+        <React.Fragment key={item.name}>{item.node}</React.Fragment>
+      ))}
+    </>
+  );
   //#endregion
 };
 
