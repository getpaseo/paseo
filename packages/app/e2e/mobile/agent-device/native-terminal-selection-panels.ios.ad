context platform=ios timeout=60000 retries=1
env APP_ID=sh.paseo.debug

open "${APP_ID}"
wait "id=\"workspace-tab-switcher-trigger\"" 20000
press "id=\"workspace-tab-switcher-trigger\""
press "id=\"workspace-tab-switcher-new-terminal\""
wait "id=\"terminal-keyboard-toggle\"" 10000
press "id=\"terminal-keyboard-toggle\""
type "clear; printf '                    PASEO_TARGET\\n'" --delay-ms 0
press "id=\"terminal-key-enter\""
wait "text" "PASEO_TARGET" 10000
longpress "label=\"PASEO_TARGET\"" 550
wait "id=\"terminal-copy\"" 10000
is visible "id=\"terminal-copy\""
gesture pan 198 167 170 0 700
is visible "id=\"terminal-copy\""
gesture pan 198 167 -170 0 700
is visible "id=\"terminal-copy\""
close
