context platform=android timeout=90000 retries=1
env APP_ID=sh.paseo.debug

open "${APP_ID}"
wait "id=\"workspace-header-menu-trigger\"" 45000
press "id=\"workspace-header-menu-trigger\"" --settle
wait "role=\"button\" label=\"New terminal\"" 10000
press "role=\"button\" label=\"New terminal\"" --settle
wait "id=\"terminal-keyboard-toggle\"" 10000
press "id=\"terminal-keyboard-toggle\""
press "id=\"terminal-surface\""
type "printf '__AD_TAP_OK__\\n'" --delay-ms 0
press "id=\"terminal-key-enter\""
wait "text" "__AD_TAP_OK__" 10000
type "printf '__AD_ENTER_OK__\\n'" --delay-ms 0
press "id=\"terminal-key-enter\""
wait "text" "__AD_ENTER_OK__" 10000
close
