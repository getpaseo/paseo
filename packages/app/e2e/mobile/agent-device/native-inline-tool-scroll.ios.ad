context platform=ios timeout=60000 retries=0
env APP_ID=sh.paseo.debug

open "${APP_ID}"
wait "id=\"workspace-tabs-scroll\"" 10000
wait "role=\"button\" label=\"Scroll probe\" value=\"expanded\"" 10000
gesture pan 600 850 0 -180 600
gesture pan 600 850 0 -180 600
gesture pan 600 850 0 -180 600
gesture pan 600 850 0 -180 600
gesture pan 600 850 0 -180 600
gesture pan 600 850 0 -180 600
gesture pan 600 850 0 -180 600
gesture pan 600 850 0 -150 600
wait "label=\"Output\"" 3000
wait "label=\"SCROLL_REACHED_OUTPUT\"" 3000
click 600 628
click 600 628
wait "label=\"Input\"" 10000
close
