{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@getpaseo/client/internal/*": ["../client/src/*.ts"],
      "@getpaseo/highlight": ["../highlight/src/index.ts"],
      "@getpaseo/protocol/*": ["../protocol/src/*.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "react-native-web.d.ts"
  ]
}
