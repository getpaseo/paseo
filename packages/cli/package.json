{
  "name": "@hubcode/cli",
  "version": "2.8.2",
  "description": "Control Claude Code, Codex, and OpenCode agents from your terminal — part of Hubcode.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Hubtool Inc. <ceo@hubtool.ai>",
  "homepage": "https://hubcode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hubtool/hubcode.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/hubtool/hubcode/issues"
  },
  "keywords": [
    "hubcode",
    "claude-code",
    "codex",
    "opencode",
    "ai",
    "agents",
    "cli",
    "coding-agent",
    "mcp",
    "developer-tools"
  ],
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "hubcode": "bin/hubcode"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\" && tsc -p tsconfig.json --incremental false",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:local",
    "test:local": "tsx tests/run-all.ts",
    "test:e2e": "npm run test:local",
    "test:e2e:lifecycle": "npx tsx tests/e2e/agent-lifecycle.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@hubcode/relay": "2.8.2",
    "@hubcode/server": "2.8.2",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "mime-types": "^2.1.35",
    "ws": "^8.14.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/ws": "^8.5.8",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "zx": "^8.8.5"
  }
}
