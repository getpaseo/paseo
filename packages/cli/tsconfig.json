{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "paths": {
      "@getpaseo/client/internal/*": ["../client/src/*.ts"],
      "@getpaseo/highlight": ["../highlight/src/index.ts"],
      "@getpaseo/protocol/*": ["../protocol/src/*.ts"],
      "@getpaseo/relay": ["../relay/src/index.ts"],
      "@getpaseo/relay/*": ["../relay/src/*.ts"],
      "@getpaseo/server": ["../server/src/server/exports.ts"],
      "@getpaseo/server/agent-hooks": ["../server/src/terminal/agent-hooks/provider-registry.ts"],
      "@getpaseo/server/utils/tool-call-parsers": ["../server/src/utils/tool-call-parsers.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
