{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "~/*": ["./src/*"],
      // The Android version-code formula is owned by packages/app because the Expo
      // config and F-Droid Gradle plugin evaluate it with no build step. Aliased in
      // rather than duplicated; vite-tsconfig-paths resolves it for build and tests.
      // Extensionless: TypeScript resolves the sibling .d.ts, Vite resolves the .js.
      "~android-version-codes": ["../app/android-version-codes"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
