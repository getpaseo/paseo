{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "../../plugin-examples/**/*.ts",
    "../../plugin-examples/**/*.tsx",
    "../../plugins/paseo-workflow/**/*.ts",
    "../../plugins/paseo-workflow/**/*.tsx"
  ],
  "exclude": ["../../plugins/paseo-workflow/**/*.test.ts"]
}
