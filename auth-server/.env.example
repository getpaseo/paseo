# Database
# Local (docker-compose):
DATABASE_URL=postgresql://hubcode:hubcode_secret@localhost:5432/hubcode_auth
# Neon (production):
# DATABASE_URL=postgresql://user:password@host.neon.tech/hubcode_auth?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=your-random-32-char-secret-here
BETTER_AUTH_URL=http://localhost:3002

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth App
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Chat — shared secret for trusted server-to-server calls from colyseus-server
# to /api/internal/chat/*. Must match COLYSEUS_INTERNAL_SECRET in colyseus-server.
COLYSEUS_INTERNAL_SECRET=dev-secret

# Chat uploads (LocalStack in dev, R2/S3 in prod).
# LocalStack defaults:
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=hubcode-uploads
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# Optional public URL — set when objects are served from a CDN instead of
# being fetched through the signed URL origin.
# S3_PUBLIC_BASE_URL=https://cdn.hubcode.ai
