+#define ucol_open (::hermes::platform_unicode::icuFunctions()->ucol_open)
+#undef ucol_close
+#define ucol_close (::hermes::platform_unicode::icuFunctions()->ucol_close)
+#undef ucol_setAttribute
+#define ucol_setAttribute \
+  (::hermes::platform_unicode::icuFunctions()->ucol_setAttribute)
+#undef ucol_strcoll
+#define ucol_strcoll (::hermes::platform_unicode::icuFunctions()->ucol_strcoll)
+#undef udat_open
+#define udat_open (::hermes::platform_unicode::icuFunctions()->udat_open)
+#undef udat_close
+#define udat_close (::hermes::platform_unicode::icuFunctions()->udat_close)
+#undef udat_format
+#define udat_format (::hermes::platform_unicode::icuFunctions()->udat_format)
+#undef uloc_getDefault
+#define uloc_getDefault \
+  (::hermes::platform_unicode::icuFunctions()->uloc_getDefault)
+#undef unorm2_getNFCInstance
+#define unorm2_getNFCInstance \
+  (::hermes::platform_unicode::icuFunctions()->unorm2_getNFCInstance)
+#undef unorm2_getNFDInstance
+#define unorm2_getNFDInstance \
+  (::hermes::platform_unicode::icuFunctions()->unorm2_getNFDInstance)
+#undef unorm2_getNFKCInstance
+#define unorm2_getNFKCInstance \
+  (::hermes::platform_unicode::icuFunctions()->unorm2_getNFKCInstance)
+#undef unorm2_getNFKDInstance
+#define unorm2_getNFKDInstance \
+  (::hermes::platform_unicode::icuFunctions()->unorm2_getNFKDInstance)
+#undef unorm2_normalize
+#define unorm2_normalize \
+  (::hermes::platform_unicode::icuFunctions()->unorm2_normalize)
+
+#endif // HERMES_ICU_LOADER_NO_MACROS
