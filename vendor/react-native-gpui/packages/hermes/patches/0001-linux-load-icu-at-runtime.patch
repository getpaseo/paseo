diff --git a/lib/Platform/Unicode/ICULoader.cpp b/lib/Platform/Unicode/ICULoader.cpp
new file mode 100644
index 000000000..699f41aba
--- /dev/null
+++ b/lib/Platform/Unicode/ICULoader.cpp
@@ -0,0 +1,136 @@
+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+#include "hermes/Platform/Unicode/PlatformUnicode.h"
+
+#ifdef HERMES_ICU_RUNTIME_LOAD
+
+/// This file fills the ICUFunctions table. It must not use the redirecting
+/// macros from ICULoader.h, or every lookup would call back into itself.
+#define HERMES_ICU_LOADER_NO_MACROS 1
+#include "hermes/Platform/Unicode/icu.h"
+
+#include <dlfcn.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+namespace hermes {
+namespace platform_unicode {
+
+namespace {
+
+ICUFunctions gFunctions;
+
+/// Resolves one entry point, preferring the versioned symbol ("ucol_open_78")
+/// and falling back to the plain name (ICU built without renaming).
+template <typename Fn>
+bool resolveSymbol(void *handle, const char *name, int version, Fn *out) {
+  std::string suffixed = std::string(name) + "_" + std::to_string(version);
+  if (void *symbol = dlsym(handle, suffixed.c_str())) {
+    *out = reinterpret_cast<Fn>(symbol);
+    return true;
+  }
+  if (void *symbol = dlsym(handle, name)) {
+    *out = reinterpret_cast<Fn>(symbol);
+    return true;
+  }
+  return false;
+}
+
+bool resolveAll(void *handle, int version) {
+#define HERMES_ICU_SYMBOL(name)                                    \
+  if (!resolveSymbol(handle, #name, version, &gFunctions.name)) {  \
+    return false;                                                  \
+  }
+  HERMES_ICU_SYMBOL(u_strToLower);
+  HERMES_ICU_SYMBOL(u_strToUpper);
+  HERMES_ICU_SYMBOL(ucol_open);
+  HERMES_ICU_SYMBOL(ucol_close);
+  HERMES_ICU_SYMBOL(ucol_setAttribute);
+  HERMES_ICU_SYMBOL(ucol_strcoll);
+  HERMES_ICU_SYMBOL(udat_open);
+  HERMES_ICU_SYMBOL(udat_close);
+  HERMES_ICU_SYMBOL(udat_format);
+  HERMES_ICU_SYMBOL(uloc_getDefault);
+  HERMES_ICU_SYMBOL(unorm2_getNFCInstance);
+  HERMES_ICU_SYMBOL(unorm2_getNFDInstance);
+  HERMES_ICU_SYMBOL(unorm2_getNFKCInstance);
+  HERMES_ICU_SYMBOL(unorm2_getNFKDInstance);
+  HERMES_ICU_SYMBOL(unorm2_normalize);
+#undef HERMES_ICU_SYMBOL
+  return true;
+}
+
+/// Returns the version to try, or -1 to search. 0 means "do not load".
+int requestedVersion() {
+  const char *value = std::getenv("HERMES_ICU_VERSION");
+  if (value == nullptr || *value == '\0') {
+    return -1;
+  }
+  char *end = nullptr;
+  long version = std::strtol(value, &end, 10);
+  if (end == value || *end != '\0' || version < 0 || version > 1000) {
+    return -1;
+  }
+  return static_cast<int>(version);
+}
+
+void warnNoICU() {
+  std::fprintf(
+      stderr,
+      "hermes: no system ICU found (libicui18n.so.N); non-ASCII case "
+      "mapping, collation and normalization are disabled\n");
+}
+
+const ICUFunctions *loadVersion(int version) {
+  std::string soname = "libicui18n.so." + std::to_string(version);
+  void *handle = dlopen(soname.c_str(), RTLD_NOW | RTLD_LOCAL);
+  if (handle == nullptr) {
+    return nullptr;
+  }
+  if (!resolveAll(handle, version)) {
+    dlclose(handle);
+    return nullptr;
+  }
+  return &gFunctions;
+}
+
+const ICUFunctions *load() {
+  int requested = requestedVersion();
+  if (requested == 0) {
+    warnNoICU();
+    return nullptr;
+  }
+  if (requested > 0) {
+    const ICUFunctions *functions = loadVersion(requested);
+    if (functions == nullptr) {
+      warnNoICU();
+    }
+    return functions;
+  }
+  for (int version = 100; version >= 50; --version) {
+    if (const ICUFunctions *functions = loadVersion(version)) {
+      return functions;
+    }
+  }
+  warnNoICU();
+  return nullptr;
+}
+
+} // namespace
+
+const ICUFunctions *icuFunctions() {
+  static const ICUFunctions *functions = load();
+  return functions;
+}
+
+} // namespace platform_unicode
+} // namespace hermes
+
+#endif // HERMES_ICU_RUNTIME_LOAD
