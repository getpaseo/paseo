+#define HERMES_PLATFORM_UNICODE_ICULOADER_H
+
+#ifdef HERMES_ICU_RUNTIME_LOAD
+
+/// The ICU entry points Hermes uses. Every one of them is resolved with
+/// dlsym() against the system's libicui18n at first use; see ICULoader.cpp.
+/// Types come from the ICU headers, so they never drift.
+struct ICUFunctions {
+  decltype(&::u_strToLower) u_strToLower;
+  decltype(&::u_strToUpper) u_strToUpper;
+  decltype(&::ucol_open) ucol_open;
+  decltype(&::ucol_close) ucol_close;
+  decltype(&::ucol_setAttribute) ucol_setAttribute;
+  decltype(&::ucol_strcoll) ucol_strcoll;
+  decltype(&::udat_open) udat_open;
+  decltype(&::udat_close) udat_close;
+  decltype(&::udat_format) udat_format;
+  decltype(&::uloc_getDefault) uloc_getDefault;
+  decltype(&::unorm2_getNFCInstance) unorm2_getNFCInstance;
+  decltype(&::unorm2_getNFDInstance) unorm2_getNFDInstance;
+  decltype(&::unorm2_getNFKCInstance) unorm2_getNFKCInstance;
+  decltype(&::unorm2_getNFKDInstance) unorm2_getNFKDInstance;
+  decltype(&::unorm2_normalize) unorm2_normalize;
+};
+
+namespace hermes {
+namespace platform_unicode {
+
+/// Returns the function table for the system ICU, or nullptr when no ICU with
+/// every required entry point could be loaded. The search runs once.
+const ICUFunctions *icuFunctions();
+
+} // namespace platform_unicode
+} // namespace hermes
+
+#ifndef HERMES_ICU_LOADER_NO_MACROS
