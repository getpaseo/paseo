+/// Converts a UTF-8 path to UTF-16, the form LoadLibraryExW takes. Returns
+/// false when the input is not valid UTF-8.
+static bool hermes_napi_utf8ToWide(const char *utf8, std::wstring &out) {
+  // An empty path is never valid, and MultiByteToWideChar rejects a zero
+  // length, so reject it before asking.
+  if (utf8 == nullptr || *utf8 == '\0') {
+    return false;
+  }
+  const int length = MultiByteToWideChar(
+      CP_UTF8, MB_ERR_INVALID_CHARS, utf8, -1, nullptr, 0);
+  if (length <= 0) {
+    return false;
+  }
+  out.resize(static_cast<size_t>(length));
+  // The call writes the terminating NUL too; resize() has already made room
+  // for it, and the returned buffer is one longer than the text.
+  const int written = MultiByteToWideChar(
+      CP_UTF8, MB_ERR_INVALID_CHARS, utf8, -1, &out[0], length);
+  if (written <= 0) {
+    return false;
+  }
+  // Drop the terminator MultiByteToWideChar wrote so the string's own
+  // terminator is the only one.
+  out.resize(static_cast<size_t>(written - 1));
+  return true;
+}
+
+/// The system's message for the last failed Win32 call, as UTF-8. This is what
+/// tells a user that an addon needs `uv_*`, or was built without the
+/// node-gyp delay-load hook (a missing `node.exe` import).
+static std::string hermes_napi_lastErrorMessage() {
+  const DWORD error = GetLastError();
+  if (error == 0) {
+    return "unknown error";
+  }
+  LPWSTR buffer = nullptr;
+  const DWORD length = FormatMessageW(
+      FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM |
+          FORMAT_MESSAGE_IGNORE_INSERTS,
+      nullptr,
+      error,
+      MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT),
+      reinterpret_cast<LPWSTR>(&buffer),
+      0,
+      nullptr);
+  std::string message;
+  if (length == 0 || buffer == nullptr) {
+    message = "error " + std::to_string(error);
+    if (buffer != nullptr) {
+      LocalFree(buffer);
+    }
+    return message;
+  }
+  const int utf8Length = WideCharToMultiByte(
+      CP_UTF8,
+      0,
+      buffer,
+      static_cast<int>(length),
+      nullptr,
+      0,
+      nullptr,
+      nullptr);
+  if (utf8Length > 0) {
+    message.resize(static_cast<size_t>(utf8Length));
+    WideCharToMultiByte(
+        CP_UTF8,
+        0,
+        buffer,
+        static_cast<int>(length),
+        &message[0],
+        utf8Length,
+        nullptr,
+        nullptr);
+  } else {
+    message = "error " + std::to_string(error);
+  }
+  LocalFree(buffer);
+  // FormatMessage's text ends with a newline; a raised TypeError should not.
+  while (!message.empty() &&
+         (message.back() == '\n' || message.back() == '\r' ||
+          message.back() == ' ' || message.back() == '.')) {
+    message.pop_back();
+  }
+  // Some system messages are templates — "193: %1 is not a valid Win32
+  // application" — and `FORMAT_MESSAGE_IGNORE_INSERTS` leaves the placeholder
+  // in place because there is no argument array to fill it from. The only
+  // insert these messages take is the name of the file, so substitute the
+  // caller-visible noun for it rather than showing a user a bare `%1`.
+  static const char *const kPlaceholder = "%1";
+  for (std::string::size_type at = message.find(kPlaceholder);
+       at != std::string::npos;
+       at = message.find(kPlaceholder, at)) {
+    message.replace(at, sizeof("%1") - 1, "the file");
+  }
+  return message;
+}
