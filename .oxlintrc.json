{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": false
  },
  "ignorePatterns": [".dev/**"],
  "plugins": ["react", "react-perf", "unicorn", "typescript", "oxc", "import", "promise"],
  "jsPlugins": ["./scripts/oxlint/paseo-plugin.mjs"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",

    "no-await-in-loop": "off",

    "no-unused-expressions": "error",
    "no-useless-catch": "error",
    "preserve-caught-error": "error",
    "require-await": "off",
    "no-async-promise-executor": "error",
    "no-useless-escape": "error",
    "no-empty-pattern": "error",
    "no-self-assign": "error",
    "no-shadow": "error",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",

    "unicorn/no-useless-spread": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/no-new-array": "error",
    "unicorn/no-empty-file": "error",

    "promise/always-return": "error",
    "promise/no-multiple-resolved": "error",

    "react/no-array-index-key": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/jsx-no-constructed-context-values": "error",
    "react/no-unescaped-entities": "error",
    "react/button-has-type": "error",
    "react/jsx-max-depth": ["error", { "max": 6 }],

    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",

    "react-perf/jsx-no-new-array-as-prop": "error",
    "react-perf/jsx-no-new-function-as-prop": "error",
    "react-perf/jsx-no-new-object-as-prop": "error",
    "react-perf/jsx-no-jsx-as-prop": "error",

    "oxc/no-map-spread": "error",
    "oxc/no-async-endpoint-handlers": "error",
    "oxc/only-used-in-recursion": "error",

    "typescript/no-explicit-any": "error",
    "typescript/prefer-as-const": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/consistent-type-definitions": ["error", "interface"],

    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css",
          "**/expo-router/entry",
          "**/event-target-polyfill",
          "**/dotenv/config",
          "**/react-native",
          "**/@/styles/unistyles",
          "**/src/styles/unistyles",
          "**/@/test/window-local-storage"
        ]
      }
    ],

    "no-nested-ternary": "error",
    "no-unneeded-ternary": "error",

    "complexity": ["error", { "max": 20 }],
    "max-depth": ["error", { "max": 4 }],
    "max-nested-callbacks": ["error", { "max": 3 }]
  },
  "overrides": [
    // Exceptions name individual APIs in individual modules; new APIs still fail in these files.
    // TODO entries are runtime debt, not startup exemptions. Do not add directory-wide exceptions.
    {
      "files": ["packages/server/src/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      "rules": {
        "paseo/no-sync-io": [
          "error",
          {
            "allow": {
              // TODO: literal executableExists is a synchronous public capability; move its callers and Windows existence predicates to async together.
              "executable-resolution/executable-resolution.ts": ["existsSync"],
              // TODO: winget enumeration shares synchronous existence predicates with literal lookup; convert the executable-resolution boundary together.
              "executable-resolution/windows.ts": ["readdirSync"],
              // TODO: live file-change classification is a synchronous event mapper; move the probe to async event ingestion.
              "server/agent/providers/claude/agent.ts": ["existsSync"],
              // TODO: new-session construction still resolves its project directory synchronously; move preparation before construction.
              "server/agent/providers/claude/project-dir.ts": ["realpathSync"],
              // TODO: live subagent output is read by a synchronous event mapper; add bounded async loading at ingestion.
              "server/agent/providers/claude/subagents/workflow-output.ts": [
                "closeSync",
                "openSync",
                "readSync"
              ],
              // TODO: diagnostics probes provider-owned auth/session storage; convert alongside provider discovery and readiness.
              "server/agent/providers/omp/agent.ts": ["existsSync"],
              // TODO: synchronous provider configuration discovery; move discovery into async launch preparation.
              "server/agent/providers/omp/provider-config.ts": ["existsSync"],
              // TODO: synchronous session-root selection is shared by descriptor builders; migrate callers with explicit readiness.
              "server/agent/providers/omp/session-descriptor.ts": ["existsSync"],
              // TODO: launch directory creation shares the server generation/start state machine; audit concurrent rotation before adding an await.
              "server/agent/providers/opencode/server-manager.ts": ["mkdirSync"],
              // TODO: launch preparation owns MCP config merge, extension generation and synchronous cleanup; migrate lifecycle and diagnostics together.
              "server/agent/providers/pi/agent.ts": [
                "existsSync",
                "mkdtempSync",
                "readFileSync",
                "rmSync",
                "writeFileSync"
              ],
              // Provider child process: Pi loads this extension outside the daemon; it reads child-agent status there.
              "server/agent/providers/pi/extensions/pi-subagents/index.ts": ["readFileSync"],
              // Startup/shutdown only: remove stale Unix listening sockets before bind and during disposal.
              "server/bootstrap.ts": ["existsSync", "unlinkSync"],
              // Startup configuration resolution: detect the bundled app distribution before the daemon listens.
              "server/config.ts": ["existsSync"],
              // Startup identity: load or create the daemon keypair before accepting connections.
              "server/daemon-keypair.ts": ["existsSync", "readFileSync"],
              // Fatal exit diagnostics: synchronously flush the exit reason when the worker is about to terminate.
              "server/daemon-worker.ts": ["appendFileSync", "mkdirSync"],
              // Startup host identity: memoized scutil lookup is warmed before listening; later callers use the cache.
              "server/host-name.ts": ["execFileSync"],
              // TODO: relationship persistence is atomic with enrollment/revocation state transitions; serialize those transitions before async writes.
              "server/hub/relationship-controller.ts": [
                "existsSync",
                "readFileSync",
                "renameSync",
                "rmSync"
              ],
              // Local client bootstrap: reads the local credential and pid lock to select/authenticate a daemon connection.
              "server/local-credential.ts": ["readFileSync"],
              // Startup logger construction: create the log directory before opening the logging destination.
              "server/logger.ts": ["mkdirSync"],
              // TODO: runtime skill commands resolve their bundled source through a synchronous targets capability; migrate the capability and controller together.
              "server/orchestration-skills/internal/paths.ts": ["existsSync"],
              // Module initialization: the package version is resolved once and cached at import.
              "server/package-version.ts": ["existsSync", "readFileSync"],
              // Startup config and exported synchronous configuration API; runtime DaemonConfigStore uses the async load/save capabilities.
              "server/persisted-config.ts": ["existsSync", "readFileSync"],
              // Startup pid identity: read and memoize the Linux boot id for the daemon lock.
              "server/pid-lock.ts": ["readFileSync"],
              // Startup builtin loader construction: select the bundled plugin root before loading plugins.
              "server/plugins/builtin/index.ts": ["existsSync"],
              // Build child process: plugin graph traversal and esbuild preparation run in the isolated compiler process.
              "server/plugins/compiler-build.ts": ["existsSync", "readFileSync", "realpathSync"],
              // Build child process: select the esbuild binary for the isolated plugin compiler.
              "server/plugins/compiler-esbuild.ts": ["existsSync"],
              // Build child process: TypeScript resolution and source reads run in the isolated plugin compiler.
              "server/plugins/compiler-imports.ts": ["readFileSync", "realpathSync"],
              // TODO: plugin install/update/remove commits sources.json synchronously; preserve record/write ordering with an async mutation queue.
              "server/plugins/managed-source.ts": ["existsSync", "readFileSync"],
              // TODO: shared synchronous persistence supports startup identity plus Hub/plugin/push runtime writers; migrate those owners before removing these exports.
              "server/private-files.ts": [
                "chmodSync",
                "mkdirSync",
                "realpathSync",
                "renameSync",
                "rmSync",
                "writeFileSync"
              ],
              // TODO: constructor load plus runtime renew/revoke/prune use synchronous persistence; introduce ordered async mutations and readiness.
              "server/push/token-store.ts": ["existsSync", "readFileSync"],
              // Startup identity: load or create the server id before accepting connections.
              "server/server-id.ts": ["existsSync", "readFileSync"],
              // Listener lifecycle only: unlink the Unix socket before binding or after stopping the proxy.
              "server/service-proxy.ts": ["existsSync", "unlinkSync"],
              // TODO: self-update origin validation exposes synchronous package-root and realpath checks; migrate validation and its runtime interface together.
              "server/session/daemon/install-origin.ts": ["existsSync", "readFileSync"],
              // TODO: npm self-update inspection probes the reported install path; move the probe into bounded async installation inspection.
              "server/session/daemon/npm-global-cli.ts": ["lstatSync"],
              // Speech child process: model-file validation runs in the worker-backed local speech provider.
              "server/speech/providers/local/sherpa/sherpa-offline-recognizer.ts": ["existsSync"],
              // Speech child process: native addon discovery and patchelf run outside the daemon.
              "server/speech/providers/local/sherpa/sherpa-onnx-node-loader.ts": [
                "existsSync",
                "spawnSync"
              ],
              // Speech child process: model-file validation runs in the worker-backed local speech provider.
              "server/speech/providers/local/sherpa/sherpa-tts.ts": ["existsSync"],
              // TODO: static request selection and index injection need bounded async serving with response/error ownership; keep this as a separate request-path conversion.
              "server/web-ui.ts": ["readFileSync", "statSync"],
              // Startup registry hydration: check persisted workspace directories before the runtime reconciliation service starts.
              "server/workspace-registry-bootstrap.ts": ["statSync"],
              // Terminal child process: hook config installation/removal is owned by terminal creation and teardown in the worker.
              "terminal/agent-hooks/agent-hook-installer.ts": [
                "existsSync",
                "readFileSync",
                "rmSync"
              ],
              // Terminal child process: launcher readiness and PTY record ownership run outside the daemon.
              "terminal/terminal-worker-process.ts": [
                "chmodSync",
                "closeSync",
                "existsSync",
                "openSync",
                "rmSync",
                "writeSync"
              ],
              // Worker startup only: choose and secure the local listening socket before accepting a controller.
              "terminal/terminal-worker-socket-path.ts": ["lstatSync", "mkdirSync"],
              // Startup only: build an independent worker installation before launching; Electron ASAR sources require plain fs reads.
              "terminal/terminal-worker-runtime.ts": [
                "chmodSync",
                "existsSync",
                "mkdirSync",
                "readdirSync",
                "readFileSync",
                "renameSync",
                "rmSync",
                "statSync",
                "writeFileSync"
              ],
              // TODO: CLI shim lookup moved out of terminal.ts; migrate the executable-resolution boundary together.
              "terminal/paseo-cli-path.ts": ["existsSync"],
              // Node loader thread: TypeScript terminal-worker resolution runs in the loader, outside the daemon event loop.
              "terminal/terminal-ts-loader.mjs": ["existsSync"],
              // Terminal child process: executable preparation and shell integration run in the worker-backed terminal manager.
              "terminal/terminal.ts": [
                "accessSync",
                "chmodSync",
                "existsSync",
                "mkdirSync",
                "readFileSync",
                "statSync"
              ],
              // TODO: legacy realpath helpers still serve install-origin validation and other synchronous consumers; migrate remaining callers before removing them.
              "utils/path.ts": ["realpathSync"]
            }
          }
        ]
      }
    },
